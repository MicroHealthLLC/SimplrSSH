# SimplrSSH: deliberate settings for the M5Stack Tab5 (ESP32-P4, 32 MB PSRAM, 16 MB flash)
# with the Tab5 Keyboard. ESP-IDF applies this file after sdkconfig.defaults when building for
# esp32p4, so the shared attack-surface settings there apply too; this file only adds what the
# Tab5 needs. Build: idf.py -B build-tab5 -D IDF_TARGET=esp32p4 -D SDKCONFIG=sdkconfig.tab5 build
# As with sdkconfig.defaults: when changing a setting here, update sdkconfig.tab5 too.

# --- Flash, PSRAM, CPU -----------------------------------------------------------
# 16 MB flash in QIO mode, as M5Stack's factory firmware uses
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# The same partition layout as the T-Deck: settings (nvs) after the app (AI_RULES.md, Persistence)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# 32 MB hex PSRAM at 200 MHz (the 200 MHz option is marked experimental in ESP-IDF 5.5)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# Skip the full PSRAM test on every boot (32 MB would take seconds)
CONFIG_SPIRAM_MEMTEST=n
# Allocations above 16 KB go to PSRAM (as on the T-Deck), keeping internal RAM for stacks and DMA
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Full speed for TLS, SSH crypto and rendering 1280x720
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# --- WiFi through the ESP32-C6 co-processor (esp_hosted over SDIO) -------------
# The Tab5's C6 sits on SDIO slot 1 (CLK 12, CMD 13, D0-D3 11/10/9/8, reset GPIO 15)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=15
# The C6 is powered through an IO expander: board_tab5.cpp turns it on, then starts esp_hosted
# (the default would start it before app_main, while the C6 is still unpowered)
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
# No Bluetooth over the co-processor (AI_RULES.md: no Bluetooth)
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=n
CONFIG_ESP_HOSTED_ENABLE_BT_BLUEDROID=n
# Station only, as on the T-Deck: no access point API on the host side
CONFIG_WIFI_RMT_SOFTAP_SUPPORT=n
# The host-side WiFi driver keeps no copy of the WiFi password in NVS (the vault has it);
# the co-processor is told the same at runtime (esp_wifi_set_storage(WIFI_STORAGE_RAM))
CONFIG_WIFI_RMT_NVS_ENABLED=n

# --- Display (MIPI-DSI 720x1280 panel shown as 1280x720 landscape) ------------
# Rotate the LVGL frame with the ESP32-P4's pixel-processing accelerator instead of the CPU
CONFIG_LVGL_PORT_ENABLE_PPA=y
# The fonts this board uses: 16 (status, buttons), 18 (terminal), 20 (input, chat, titles)
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# --- Audio (ChatGPT voice) ---------------------------------------------------------
# ES7210 microphones and ES8388 speaker codec
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES8388_SUPPORT=y

# --- Unused BSP features --------------------------------------------------------
# The BSP's camera stack is never started; build no camera sensor drivers
CONFIG_CAMERA_SC2336=n
CONFIG_CAMERA_SC202CS=n
