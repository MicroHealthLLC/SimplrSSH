# SimplrSSH: deliberate settings for the LilyGO T-Deck (ESP32-S3, 8 MB PSRAM).
# Keep these lean and minimal-attack-surface; see AI_RULES.md. ESP-IDF applies
# this file only to options missing from sdkconfig, so when changing one here,
# also remove it from sdkconfig (or run `idf.py menuconfig`) and commit both.

# --- Attack surface: station mode only -------------------------------------
# No access point / DHCP server: the device only joins networks
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LWIP_DHCPS=n
# IPv4 only (SSH targets are resolved/connected with AF_INET)
CONFIG_LWIP_IPV6=n
# libssh2 protocol tracing is never used in production and could log session data
CONFIG_LIBSSH2_DEBUG_ENABLE=n

# --- Build and boot (both boards) ---------------------------------------------
# app_main mounts the SD card, starts the display and touch and builds the terminal screen
# before handing over to keypad_task; the 3.5 KB default overflows. Freed when it returns.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Optimize for speed (TLS, SSH crypto, rendering); assertions compiled out
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# Problems only in the log (AI_RULES.md: ESP_LOGI sparingly)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# --- Internal RAM: move bulk buffers to PSRAM --------------------------------
# WiFi/LWIP buffers in PSRAM when possible
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# mbedTLS follows the heap policy (large allocations go to PSRAM)
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# LVGL uses the system heap instead of a fixed 64 KB internal pool
CONFIG_LV_USE_CLIB_MALLOC=y
# WiFi receive code runs from flash instead of internal RAM: terminal and ChatGPT traffic
# doesn't need the extra throughput, and it makes room for the sleep code ('sleep', T-Deck)
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# 'sleep' keeps the CPU powered in light sleep: powering it down saves about 0.65 mA but needs
# about 9 KB of internal RAM for its saved state and code
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n

# --- Flash / boot time --------------------------------------------------------
# Only Montserrat 10/12 (UI) and 14 (LVGL default) are used
CONFIG_LV_FONT_MONTSERRAT_8=n
CONFIG_LV_FONT_MONTSERRAT_18=n
CONFIG_LV_FONT_MONTSERRAT_20=n
CONFIG_LV_FONT_MONTSERRAT_28=n
# Skip the full PSRAM test on every boot
CONFIG_SPIRAM_MEMTEST=n

# --- Persistence -----------------------------------------------------------
# The WiFi driver would keep its own plain-text copy of the WiFi password in NVS;
# networks are saved by the app instead (password encrypted in the vault)
CONFIG_ESP_WIFI_NVS_ENABLED=n
# Long file names on the SD card (key files like backup_server.pem, backup folder)
CONFIG_FATFS_LFN_HEAP=y

# --- Audio (ChatGPT voice) --------------------------------------------------
# The T-Deck's microphone codec is an ES7210; don't build the other codec drivers
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES8311_SUPPORT=n
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
